# ─────────────────────────────────────────────────────────────
# OmniDesk — environment template
#
# These are SERVER-side variables for the Vercel serverless
# function api/generate-draft.ts. Set them in the Vercel
# dashboard: Project → Settings → Environment Variables.
#
# Never prefix them with VITE_ — anything with that prefix gets
# baked into the public JavaScript bundle and would leak your key.
# ─────────────────────────────────────────────────────────────

# Required for real AI drafts. Without it, the app falls back to
# its built-in smart mock, so the demo still works.
OPENAI_API_KEY=sk-...

# Optional — default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Optional — any OpenAI-compatible endpoint (OpenRouter, Groq, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1